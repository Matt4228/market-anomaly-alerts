DATABASE_URL=postgresql://postgres:postgres@localhost:5432/market_alerts

TRACKED_TICKERS=AAPL,MSFT,GOOGL,TSLA,SPY
OPENBB_PROVIDER=yfinance

POLL_INTERVAL_MINUTES=5
# Skip polls outside NYSE hours. Set false to see live ticks while developing at night.
MARKET_HOURS_ONLY=true
ALERT_COOLDOWN_MINUTES=30
ANOMALY_ZSCORE_THRESHOLD=3.0
MIN_STDDEV_FRACTION=0.0005
STALE_THRESHOLD=3
RECONCILIATION_TOLERANCE=0.02

RATE_LIMIT_CAPACITY=5
RATE_LIMIT_REFILL_PER_SEC=1.0
PRICE_CACHE_TTL_SECONDS=60

# Optional - leave blank to skip Slack alerts
SLACK_WEBHOOK_URL=

# The admin token: required to edit tickers and thresholds and to fire test
# alerts. Admin endpoints fail closed (403 on every request) if this is
# unset. The dashboard asks for it via "Unlock admin". Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
DEBUG_TOKEN=
